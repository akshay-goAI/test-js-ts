{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "type-only-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      { "name": "api", "patterns": ["src/api/**"] },
      { "name": "infrastructure", "patterns": ["src/infrastructure/**"] }
    ],
    "rules": [
      { "from": "api", "allow": ["api"] },
      { "from": "infrastructure", "allow": ["api", "infrastructure"] }
    ]
  }
}
